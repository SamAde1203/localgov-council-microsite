# Composer-managed code (rebuilt with `composer install`).
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/drush/Commands/contrib/

# Scaffold files generated by drupal/core-composer-scaffold.
/web/.csslintrc
/web/.eslintignore
/web/.eslintrc.json
/web/.ht.router.php
/web/.htaccess
/web/INSTALL.txt
/web/README.md
/web/autoload.php
/web/example.gitignore
/web/index.php
/web/robots.txt
/web/update.php
/web/web.config
/web/sites/*
!/web/sites/.gitkeep
/recipes/
/.editorconfig
/web/modules/README.txt
/web/themes/README.txt
/web/profiles/README.txt
/web/sites/README.txt

# Local environment and test output.
.env
.phpunit.cache/
*.sqlite
.DS_Store
.idea/
.vscode/
/node_modules
/tests/accessibility/screenshots/
web/themes/custom/*/node_modules/
