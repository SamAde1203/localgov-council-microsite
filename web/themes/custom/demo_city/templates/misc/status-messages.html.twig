{#
/**
 * @file
 * Status messages for Demo City Council.
 *
 * LocalGov Base wraps every message in role="contentinfo". That role is for
 * the page footer, so pages with a message had two contentinfo landmarks,
 * which axe-core flags and which confuses screen reader landmark navigation.
 * Here errors use role="alert", so they are announced straight away, and other
 * messages use role="status".
 *
 * Available variables:
 * - message_list: List of messages to be displayed, grouped by type.
 * - status_headings: List of all status types.
 * - attributes: HTML attributes for the element, including:
 *   - class: HTML classes.
 */
#}
<div data-drupal-messages>
{% block messages %}
{% for type, messages in message_list %}
  {%
    set classes = [
      'messages',
      'messages--' ~ type,
    ]
  %}
  <div role="{{ type == 'error' ? 'alert' : 'status' }}"{{ attributes.addClass(classes)|without('role', 'aria-label') }}>
    {% if status_headings[type] %}
      <h2 class="visually-hidden">{{ status_headings[type] }}</h2>
    {% endif %}
    {% if messages|length > 1 %}
      <ul class="messages__list">
        {% for message in messages %}
          <li class="messages__item">{{ message }}</li>
        {% endfor %}
      </ul>
    {% else %}
      {{ messages|first }}
    {% endif %}
  </div>
  {# Remove type specific classes. #}
  {% set attributes = attributes.removeClass(classes) %}
{% endfor %}
{% endblock messages %}
</div>
